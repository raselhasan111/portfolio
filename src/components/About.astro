---
import { siteConfig } from "../config";
import RichText from "./RichText.astro";
---

<section id="about" class="section">
  <div class="wrap">
    <div class="section-head">
      <div class="reveal">
        <span class="h-section">/ about</span>
        <h2 class="h-block" style="margin-top: 14px">
          Engineer with <em style="font-style: normal; color: var(--accent-3)">frontend</em> obsession.
        </h2>
      </div>
    </div>

    <div class="about-grid">
      <div class="reveal">
        <div class="about-side">
          <span class="mono muted label">Bio · v3.2</span>
          <div class="term">
            <div class="line"><span class="prompt">$</span> whoami</div>
            <div class="line out">→ {siteConfig.title} · {siteConfig.location}</div>
            <div class="line"><span class="prompt">$</span> cat focus.txt</div>
            <div class="line out">→ React · Next.js · TS<br />→ micro-frontends · perf · DX</div>
          </div>
        </div>
      </div>

      <div>
        <div class="reveal">
          <RichText as="p" class="about-text" text={siteConfig.aboutMe} />
        </div>

        <div class="reveal" style="--d: 80ms">
          <div class="stats">
            {
              siteConfig.stats.map((s) => (
                <div class="stat">
                  <div class="stat-val">
                    {s.value}
                    <span class="unit">{s.unit}</span>
                  </div>
                  <div class="stat-label">{s.label}</div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="reveal" style="--d: 160ms">
          <div>
            <div class="mono muted stack-eyebrow">/ stack</div>
            <div class="pills">
              {
                siteConfig.skills.map((t) => (
                  <span class="pill">
                    <span class="dot" />
                    {t}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
