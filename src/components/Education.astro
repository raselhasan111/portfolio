---
import { siteConfig } from "../config";
import RichText from "./RichText.astro";

const edu = siteConfig.education[0];
---

<section id="education" class="section">
  <div class="wrap">
    <div class="section-head">
      <div class="reveal">
        <span class="h-section">/ education</span>
        <h2 class="h-block" style="margin-top: 14px">
          Where it all <em style="font-style: normal; color: var(--accent-3)">started.</em>
        </h2>
      </div>
    </div>

    {edu && (
      <div class="reveal">
        <div class={`edu-card ${edu.gpa ? "" : "no-side"}`}>
          <div class="edu-info">
            {edu.subject ? (
              <>
                <div class="edu-degree-chip">{edu.degree}</div>
                <h3 class="h-block" style="font-size: clamp(22px, 2.4vw, 30px)">{edu.subject}</h3>
              </>
            ) : (
              <h3 class="h-block" style="font-size: clamp(22px, 2.4vw, 30px)">{edu.degree}</h3>
            )}
            <div class="school">{edu.school}</div>
            <div class="date">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3 2 8l10 5 10-5-10-5Z" />
                <path d="M6 10v6c3 2 9 2 12 0v-6" />
              </svg>
              {edu.dateRange}
            </div>

            <div class="edu-achievements">
              {edu.achievements.map((a) => (
                <div class="edu-ach">
                  <span class="ic">★</span>
                  <RichText text={a} />
                </div>
              ))}
            </div>

            {edu.coursework && edu.coursework.length > 0 && (
              <>
                <div class="edu-coursework-eyebrow">/ coursework</div>
                <div class="edu-tags">
                  {edu.coursework.map((t) => <span class="edu-tag">{t}</span>)}
                </div>
              </>
            )}
          </div>

          {edu.gpa && (
            <div class="edu-side">
              <div class="gpa-card">
                <div>
                  <div class="gpa-label">CGPA</div>
                  <div class="gpa-val">
                    {edu.gpa}
                    {edu.gpaOf && <span class="of">/{edu.gpaOf}</span>}
                  </div>
                </div>
                <div>
                  <div class="gpa-bar"><div style={`width: ${edu.gpaPct ?? 0}%`} /></div>
                  <div class="gpa-bar-label">
                    <span>0.0</span>
                    <span>{edu.gpaPct ?? 0}% — top tier</span>
                    <span>{edu.gpaOf ?? "4.0"}</span>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</section>
