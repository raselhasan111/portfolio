---
import { siteConfig } from "../config";

const year = new Date().getFullYear();

const sections = [
  { id: "about", label: "About" },
  { id: "projects", label: "Projects" },
  { id: "experience", label: "Experience" },
  { id: "education", label: "Education" },
];
---

<footer id="contact" class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="terminal">
          <div class="terminal-bar">
            <div class="pv-dots"><span /><span /><span /></div>
            <span>~/portfolio — zsh</span>
          </div>
          <div class="terminal-body">
            <div class="terminal-line"><span class="out">built with Astro + TypeScript</span></div>
            <div class="terminal-line"><span class="out">designed & developed by {siteConfig.name}</span></div>
            <div class="terminal-line"><span class="out">deployed on GitHub Pages</span></div>
            <div class="terminal-line terminal-cursor"><span style="color: var(--muted)">let's-build-something</span></div>
          </div>
        </div>
      </div>

      <div class="footer-col">
        <h4>Sitemap</h4>
        <ul>
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Connect</h4>
        <ul>
          <li><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          {siteConfig.social.twitter && (
            <li><a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer">Twitter</a></li>
          )}
          <li><a href={`mailto:${siteConfig.social.email}`}>Email</a></li>
          <li><a href={siteConfig.resume} download>Resume.pdf</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Stack</h4>
        <ul>
          <li><a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></li>
          <li><a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer">Tailwind CSS</a></li>
          <li><a href="https://www.typescriptlang.org" target="_blank" rel="noopener noreferrer">TypeScript</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bot">
      <div class="signature">
        <span style="color: var(--accent)">●</span> {siteConfig.name} · {siteConfig.title}
      </div>
      <div>© {year} — crafted with care</div>
    </div>
  </div>
</footer>
