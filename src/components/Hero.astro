---
import { siteConfig } from "../config";
import RichText from "./RichText.astro";
---

<section class="hero wrap">
  <div class="hero-left">
    <div class="reveal" style="--d: 0ms">
      <h1 class="hero-name">{siteConfig.name}</h1>
    </div>

    <div class="reveal" style="--d: 80ms">
      <p class="hero-tag">
        {siteConfig.title} at
        <a
          class="hero-tag-company"
          href={siteConfig.currentCompanyUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {siteConfig.currentCompany}
        </a>
      </p>
    </div>

    <div class="reveal" style="--d: 140ms">
      <RichText as="p" class="hero-sub" text={siteConfig.heroAboutMe} />
    </div>

    {
      siteConfig.highlights.length > 0 && (
        <div class="reveal" style="--d: 200ms">
          <ul class="hero-highlights" aria-label="Highlights">
            {siteConfig.highlights.map((h) => (
              <li>
                <RichText text={h} />
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="reveal" style="--d: 260ms">
      <div class="hero-ctas">
        <a href="#projects" class="btn btn-primary">
          View work
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14" />
            <path d="m6 13 6 6 6-6" />
          </svg>
        </a>
        <a href={siteConfig.resume} class="btn btn-ghost" download>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12" />
            <path d="m7 10 5 5 5-5" />
            <path d="M5 21h14" />
          </svg>
          Resume (PDF)
        </a>
        <a href={`mailto:${siteConfig.social.email}`} class="hero-email">Email me</a>
      </div>
    </div>

    <div class="reveal" style="--d: 300ms">
      <p class="hero-meta">{siteConfig.location} · {siteConfig.timezone}</p>
    </div>
  </div>

  <div class="reveal hero-right" style="--d: 200ms">
    <figure class="hero-photo">
      <img
        src={siteConfig.profileImage}
        alt={`Portrait of ${siteConfig.name}`}
        width="3024"
        height="4032"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>
